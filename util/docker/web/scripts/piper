#!/usr/bin/env python3
"""Bound Piper inference so callers retain time to recover from a stalled render."""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

REAL_PIPER = "/usr/local/share/piper/piper"
PRIMARY_TIMEOUT_SECONDS = 55
RETRY_TIMEOUT_SECONDS = 20
EMERGENCY_TIMEOUT_SECONDS = 10
RETRY_MAX_CHARS = 800
EMERGENCY_MAX_CHARS = 240


def output_path(args: list[str]) -> str | None:
    try:
        index = args.index("--output_file")
    except ValueError:
        return None

    return args[index + 1] if index + 1 < len(args) else None


def sentence_prefix(text: str, limit: int) -> str:
    text = " ".join(text.strip().split())
    if len(text) <= limit:
        return text

    chunk = text[:limit]
    endings = [match.end() for match in re.finditer(r"[.!?](?:\s|$)", chunk)]
    if endings and endings[-1] >= min(160, limit // 3):
        return chunk[: endings[-1]].strip()

    split_at = chunk.rfind(" ")
    return chunk[:split_at].strip() if split_at > 0 else chunk.strip()


def bounded_retry_text(text: str) -> str:
    clean = text.strip()
    if not clean:
        return clean

    # Keep the opening and, where practical, the final outro while dropping
    # middle material only after the complete primary render demonstrably stalls.
    paragraphs = [paragraph.strip() for paragraph in re.split(r"\n\s*\n+", clean) if paragraph.strip()]
    outro = paragraphs[-1] if len(paragraphs) > 1 else ""
    reserve = min(240, len(outro) + 2) if outro else 0
    prefix_limit = max(360, RETRY_MAX_CHARS - reserve)
    prefix = sentence_prefix(clean, prefix_limit)

    if outro and outro not in prefix and len(prefix) + len(outro) + 2 <= RETRY_MAX_CHARS:
        prefix = f"{prefix}\n\n{outro}"

    if len(prefix) >= len(clean):
        # A short input can still stall because the host is resource-starved. A
        # meaningfully shorter second attempt is more useful than repeating it.
        prefix = sentence_prefix(clean, max(180, int(len(clean) * 0.60)))

    return prefix


def emergency_retry_text(text: str) -> str:
    """Return a tiny complete-sentence fallback that can render under heavy load."""
    clean = text.strip()
    if not clean:
        return clean

    emergency = sentence_prefix(clean, EMERGENCY_MAX_CHARS)
    if emergency == clean and len(clean) > 120:
        emergency = sentence_prefix(clean, max(120, int(len(clean) * 0.35)))
    return emergency


def relay(result: subprocess.CompletedProcess[str]) -> None:
    if result.stdout:
        sys.stdout.write(result.stdout)
    if result.stderr:
        sys.stderr.write(result.stderr)


def run_piper(args: list[str], text: str, timeout: int) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [REAL_PIPER, *args],
        input=text,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
        check=False,
    )


def main() -> int:
    args = sys.argv[1:]
    out = output_path(args)

    # Preserve native Piper behavior for uncommon streaming/stdout invocations.
    if out is None:
        os.execv(REAL_PIPER, [REAL_PIPER, *args])

    text = sys.stdin.read()

    try:
        result = run_piper(args, text, PRIMARY_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        result = None

    if result is not None:
        relay(result)
        if result.returncode == 0:
            return 0

        # Configuration/model failures are deterministic; shortening the script
        # would hide the real error and waste more time.
        return result.returncode

    retry_text = bounded_retry_text(text)
    if not retry_text:
        print("Piper render timed out and no retry text was available.", file=sys.stderr)
        return 124

    try:
        Path(out).unlink(missing_ok=True)
        retry = run_piper(args, retry_text, RETRY_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        retry = None

    if retry is not None:
        relay(retry)
        if retry.returncode == 0:
            print(
                "Piper primary render timed out; completed a sentence-safe shortened retry.",
                file=sys.stderr,
            )
        return retry.returncode

    # The Sept. 13 production log showed that a 65s primary plus 20s retry could
    # still both time out on a resource-starved host. Keep one final tiny fallback
    # inside the same <90s caller budget so news/DJ speech degrades gracefully
    # instead of disappearing completely.
    emergency_text = emergency_retry_text(retry_text)
    if not emergency_text:
        print("Piper retries timed out and no emergency text was available.", file=sys.stderr)
        return 124

    try:
        Path(out).unlink(missing_ok=True)
        emergency = run_piper(args, emergency_text, EMERGENCY_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        print(
            f"Piper render exceeded {PRIMARY_TIMEOUT_SECONDS}s, retry exceeded "
            f"{RETRY_TIMEOUT_SECONDS}s, and emergency retry exceeded "
            f"{EMERGENCY_TIMEOUT_SECONDS}s.",
            file=sys.stderr,
        )
        return 124

    relay(emergency)
    if emergency.returncode == 0:
        print(
            "Piper primary and shortened retry timed out; completed an emergency short retry.",
            file=sys.stderr,
        )
    return emergency.returncode


if __name__ == "__main__":
    raise SystemExit(main())
